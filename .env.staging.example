# Local staging stack: copy to .env.staging and replace the placeholders.
# Never use these values for an internet-facing deployment.
DJANGO_SETTINGS_MODULE=config.settings.staging

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=en-us
DJANGO_LOG_LEVEL=INFO

# Docker Compose overrides the database and cache hosts inside the network.
DATABASE_URL=postgres://djwebmail:djwebmail@db:5432/djwebmail
REDIS_URL=redis://redis:6379/0
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key
DJANGO_SESSION_COOKIE_AGE=28800

# Local staging is HTTP-only. Production keeps the secure defaults.
CSRF_TRUSTED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Disposable local mail server (GreenMail).
DJANGO_MAIL_DOMAIN=example.test
DJANGO_MAIL_IMAP_HOST=mailserver
DJANGO_MAIL_IMAP_PORT=3143
DJANGO_MAIL_IMAP_SECURITY=none
DJANGO_MAIL_SMTP_HOST=mailserver
DJANGO_MAIL_SMTP_PORT=3025
DJANGO_MAIL_SMTP_SECURITY=none
DJANGO_MAIL_VERIFY_TLS=False
DJANGO_MAIL_TIMEOUT_SECONDS=30
DJANGO_MAIL_DEFAULT_PAGE_SIZE=50
DJANGO_MAIL_MAX_PAGE_SIZE=200
DJANGO_MAIL_LOGIN_MAX_ATTEMPTS=5
DJANGO_MAIL_LOGIN_WINDOW_SECONDS=300
