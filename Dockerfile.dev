# syntax=docker/dockerfile:1

# Development image: includes dev/test dependencies and reloads source from a
# bind mount. The production image is Dockerfile.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Dependencies first so the layer is cached when only source code changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --all-groups --no-install-project --no-editable

COPY . .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
