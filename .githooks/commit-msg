#!/bin/sh
# Conventional Commits validation for this repository.
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

msg_file="$1"

# Merge commits are exempt; their message is generated by Git.
if head -n1 "$msg_file" | grep -qE '^(Merge|Revert "Merge)'; then
  exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "commit-msg: uv not found, skipping Conventional Commits check" >&2
  exit 0
fi

if ! uv run --quiet cz check --allow-abort --commit-msg-file "$msg_file"; then
  cat >&2 <<'EOF'

commit-msg: message does not follow Conventional Commits.

  <type>(<scope>)!: <description>

  types: feat fix perf refactor docs test build ci style chore revert
  example: feat(mail): add HTMX pagination to message list

See .agents/skills/conventional-commits. Use `uv run cz commit` for a guided prompt.
EOF
  exit 1
fi
