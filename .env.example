# Django
DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://djwebmail:djwebmail@localhost:5432/djwebmail

# IMAP/SMTP (used by apps/accounts; leave empty to configure in the UI)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=True
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_TLS=True
