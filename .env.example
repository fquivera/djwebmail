# Django
DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=en-us

# Database
# SQLite by default so the project runs with no external services.
# Use PostgreSQL for parity with CI/production:
# DATABASE_URL=postgres://djwebmail:djwebmail@localhost:5432/djwebmail
DATABASE_URL=sqlite:///db.sqlite3

# Production only: comma-separated HTTPS origins, e.g. https://mail.example.com
CSRF_TRUSTED_ORIGINS=

# Server-side cache and credential encryption. Production requires both.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DJANGO_SESSION_COOKIE_AGE=28800

# IMAP/SMTP (used by apps/accounts; leave empty to configure in the UI)
DJANGO_MAIL_DOMAIN=
DJANGO_MAIL_IMAP_HOST=
DJANGO_MAIL_IMAP_PORT=993
DJANGO_MAIL_IMAP_SECURITY=ssl
DJANGO_MAIL_SMTP_HOST=
DJANGO_MAIL_SMTP_PORT=587
DJANGO_MAIL_SMTP_SECURITY=starttls
DJANGO_MAIL_VERIFY_TLS=True
DJANGO_MAIL_TIMEOUT_SECONDS=30
DJANGO_MAIL_DEFAULT_PAGE_SIZE=50
DJANGO_MAIL_MAX_PAGE_SIZE=200
DJANGO_MAIL_LOGIN_MAX_ATTEMPTS=5
DJANGO_MAIL_LOGIN_WINDOW_SECONDS=300
DJANGO_MAIL_IMAGE_PROXY_MAX_BYTES=5000000
DJANGO_MAIL_IMAGE_PROXY_TIMEOUT_SECONDS=10
DJANGO_MAIL_MAX_ATTACHMENT_BYTES=25000000
DJANGO_MAIL_MAX_ATTACHMENTS_TOTAL_BYTES=25000000
DJANGO_MAIL_MAX_ATTACHMENTS=10
DJANGO_MAIL_COMPOSE_TTL_SECONDS=3600

# Self-service password management (apps/accounts & apps/preferences).
# IMAP does not provide a native password change protocol. Configure one of the
# backend drivers below to allow users to update their credentials:
# 1. Accounts file (e.g. docker-mailserver / Dovecot postfix-accounts.cf with SHA512-CRYPT):
# DJANGO_MAIL_ACCOUNTS_FILE=/path/to/postfix-accounts.cf
DJANGO_MAIL_ACCOUNTS_FILE=
# 2. POPPASSD daemon (RFC / port 106):
# DJANGO_MAIL_POPPASSD_HOST=mail.example.com
DJANGO_MAIL_POPPASSD_HOST=
DJANGO_MAIL_POPPASSD_PORT=106
# Set to False to completely disable password changes in the UI:
DJANGO_MAIL_CHANGE_PASSWORD_ENABLED=True

# Functional tests (tests/functional). Keep disabled for normal development;
# the Compose stack enables them against its disposable GreenMail service.
FUNCTIONAL_TESTS_ENABLED=False
FUNCTIONAL_MAIL_USER=demo@example.test
FUNCTIONAL_MAIL_PASSWORD=demo
